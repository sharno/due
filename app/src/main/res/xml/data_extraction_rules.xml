<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="due.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <!-- automatic_backup.preferences_pb is intentionally device-bound and excluded. -->
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="due.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <!-- automatic_backup.preferences_pb is intentionally device-bound and excluded. -->
    </device-transfer>
</data-extraction-rules>
